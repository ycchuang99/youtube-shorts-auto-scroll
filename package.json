{
  "name": "youtube-shorts-auto-scroll",
  "version": "1.3.0",
  "description": "Auto-scroll to next Shorts video and skip ads automatically",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('youtube-shorts-auto-scroll.zip', { force: true })\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run clean && npm run package",
    "package": "zip -r youtube-shorts-auto-scroll.zip manifest.json src/ assets/ -x '*.DS_Store' -x 'assets/images/demo.png'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ycchuang99/youtube-shorts-auto-scroll.git"
  },
  "keywords": [
    "youtube",
    "shorts",
    "chrome-extension",
    "auto-scroll"
  ],
  "author": "Evan Chuang",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1"
  }
}

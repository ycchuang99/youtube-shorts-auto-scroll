{
  "name": "youtube-shorts-auto-scroll",
  "version": "1.4.1",
  "description": "Automatic scrolling and playback controls for YouTube Shorts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('youtube-shorts-auto-scroll.zip', { force: true })\"",
    "lint": "eslint .",
    "validate": "node scripts/package.js --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run package",
    "package": "node scripts/package.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ycchuang99/youtube-shorts-auto-scroll.git"
  },
  "keywords": [
    "youtube",
    "shorts",
    "chrome-extension",
    "auto-scroll"
  ],
  "author": "Evan Chuang",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1"
  }
}
